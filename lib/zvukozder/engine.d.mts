export type Dir = 'left' | 'right' | 'up' | 'down';
export type Status = 'ready' | 'playing' | 'dying' | 'clear' | 'over';
export type Mode = 'house' | 'normal' | 'scared' | 'eaten';
export type EnemyType = 'fire' | 'bolt';
export type Mover = { c: number; r: number; dir: Dir | null; p: number };
export type Player = Mover & { next: Dir | null };
export type Enemy = Mover & { id: string; idx: number; type: EnemyType; emoji: string; mode: Mode; release: number; warn: boolean };
export type Bonus = { c: number; r: number; t: number };
export type Game = { level: number; score: number; lives: number; extra: boolean; time: number; timer: number; events: string[]; dots: number; pellets: Uint8Array; remaining: number; player: Player; enemies: Enemy[]; scared: number; mute: number; combo: number; wave: number; bonus: Bonus | null; status: Status };
export const W: number;
export const H: number;
export const MAZE: string[];
export const DIRS: Record<Dir, { dx: number; dy: number }>;
export const OPP: Record<Dir, Dir>;
export const ORDER: Dir[];
export const HOME: { c: number; r: number };
export const DOOR: { c: number; r: number };
export const EXIT: { c: number; r: number };
export const SPAWN: { c: number; r: number };
export const BONUS_TILE: { c: number; r: number };
export const CORNERS: { c: number; r: number }[];
export const PLAYER_SPEED: number;
export const WARN_TIME: number;
export const TYPES: Record<EnemyType, { emoji: string; speed: number }>;
export function levelEnemies(level: number): { type: EnemyType; release: number }[];
export function scaredTime(level: number): number;
export function muteTime(level: number): number;
export function enemySpeed(level: number, type?: EnemyType): number;
export function passable(c: number, r: number, enemy: boolean): boolean;
export function canGo(c: number, r: number, dir: Dir, enemy: boolean): boolean;
export function stepFrom(c: number, r: number, dir: Dir): { c: number; r: number };
export function distMap(tc: number, tr: number, enemy: boolean): Int16Array;
export function pos(e: Mover): { x: number; y: number };
export function resetPositions(g: Game): void;
export function resetLevel(g: Game): void;
export function createGame(): Game;
export function setDirection(g: Game, dir: Dir): void;
export function dirFromKey(key: string, code?: string): Dir | null;
export function update(g: Game, dt: number, rand?: () => number): void;
